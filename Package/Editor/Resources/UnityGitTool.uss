/* Shared look for the Unity Git Tool window. Uses Unity's built-in editor color
   variables where possible so it matches the Light/Dark skin automatically. */

.gt-toolbar {
    flex-direction: row;
    align-items: center;
    padding: 6px 8px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(0, 0, 0, 0.25);
    /* Fixed chrome, not flexible content — without this, Yoga's default flex-shrink: 1 lets it get
       squeezed whenever the tree/table need more vertical room than is available (e.g. one of them
       needs a scrollbar), instead of leaving that squeeze to their own internal ScrollViews. */
    flex-shrink: 0;
}

.gt-filter-group {
    flex-direction: row;
    align-items: center;
    margin-right: 8px;
}

.gt-revision-menu {
    width: 160px;
    height: 20px;
    border-width: 0;
}

.gt-revision-menu-first {
    margin-right: 8px;
}

.gt-revision-menu > .unity-text-element {
    overflow: hidden;
    text-overflow: ellipsis;
}

/* Shared pill look for every toolbar action/toggle — Refresh, Only changes, Only conflicts,
   Hide incompatible files — so they read as one family instead of some being buttons and some
   being checkboxes. */
.gt-pill {
    height: 20px;
    border-radius: 3px;
    border-width: 0;
    padding: 0 10px;
    margin: 0 2px;
    background-color: rgba(128, 128, 128, 0.12);
}

.gt-pill:hover {
    background-color: rgba(128, 128, 128, 0.22);
}

.gt-toggle-chip-active {
    background-color: rgba(80, 140, 200, 0.35);
}

.gt-icon-button {
    width: 24px;
    height: 20px;
    border-radius: 3px;
    border-width: 0;
    align-items: center;
    justify-content: center;
    margin-right: 8px;
}

.gt-icon-button Image {
    width: 14px;
    height: 14px;
}

.gt-flex-spacer {
    flex-grow: 1;
}

.gt-panel-title {
    flex-direction: row;
    align-items: center;
    padding: 6px 10px;
    background-color: rgba(128, 128, 128, 0.08);
    border-bottom-width: 1px;
    border-bottom-color: rgba(0, 0, 0, 0.15);
    flex-shrink: 0; /* see .gt-toolbar */
}

.gt-panel-title Label {
    -unity-font-style: bold;
    font-size: 10px;
    opacity: 0.7;
    letter-spacing: 1px;
}

.gt-tree, .gt-table {
    flex-grow: 1;
}

.gt-tree-row {
    flex-direction: row;
    align-items: center;
    flex-grow: 1;
    padding-left: 2px;
    padding-right: 6px;
}

.gt-tree-icon {
    width: 16px;
    height: 16px;
    flex-shrink: 0;
}

.gt-icon-sm {
    width: 12px;
    height: 12px;
}

/* Leading icon (before the label) reserves its own trailing gap. Trailing icons/badges (after
   the label — warning, A/M/D) reserve a LEADING gap instead, so whichever one ends up last never
   leaves a hidden sibling's margin dangling before the row's edge. */
.gt-icon-leading {
    margin-right: 6px;
}

.gt-icon-trailing {
    margin-left: 6px;
}

.gt-chip {
    -unity-font-style: bold;
    font-size: 11px;
    width: 16px;
    height: 16px;
    -unity-text-align: middle-center;
    flex-shrink: 0;
}

.gt-tree-label {
    flex-grow: 1;
    overflow: hidden;
    text-overflow: ellipsis;
}

.gt-cell {
    -unity-text-align: middle-left;
    padding: 0 8px;
    height: 100%;
}

/* Inspector-style component section bar — applied to every column's cell on a header row (see
   MockRow.IsHeader) so the whole row reads as one continuous separator, not just the Property
   column. align-items/padding-top overridden back to centered/zero since headers are single-line,
   unlike the flex-start + padding-top property/value cells use to anchor multi-line array content
   to the top — left as-is here, the icon+label would sit low in a taller header row otherwise.
   min-height makes the row taller than a plain property row (DynamicHeight virtualization sizes
   each row from its tallest cell, so this cell alone is enough to grow the whole row). */
.gt-row-header {
    background-color: rgba(128, 128, 128, 0.35);
    border-top-width: 1px;
    border-top-color: rgba(0, 0, 0, 0.3);
    align-items: center;
    padding-top: 0;
    min-height: 30px;
}

.gt-row-header-label {
    -unity-font-style: bold;
}

.gt-property-cell {
    flex-direction: row;
    align-items: flex-start;
    padding-top: 4px;
}

.gt-value-cell {
    flex-direction: row;
    align-items: flex-start;
    padding: 4px;
}

/* Inspector-style controls (Vector3Field, ColorField, ...) come with their own label — hidden
   here since the Property column already shows it — and are stretched to fill the cell. */
.gt-value-field {
    flex-grow: 1;
}

/* A/B columns are read-only (SetEnabled(false)) but should still read clearly — Unity's default
   disabled look dims the whole control via opacity, which was making values hard to see. */
.gt-value-field:disabled {
    opacity: 1;
}

.gt-value-field > .unity-base-field__label,
.gt-value-field > .unity-composite-field__label {
    display: none;
}

.gt-array-block {
    flex-direction: column;
    flex-grow: 1;
}

.gt-array-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 2px;
}

.gt-array-index {
    width: 22px;
    opacity: 0.6;
    font-size: 10px;
    flex-shrink: 0;
}

.gt-actions-cell {
    flex-direction: row;
    align-items: center;
    padding: 4px 8px 4px 4px;
}

.gt-action-button {
    width: 24px;
    height: 20px;
    border-width: 0;
    margin-right: 4px;
    padding: 0;
}

.gt-cell-result {
    border-left-width: 1px;
    border-left-color: rgba(0, 0, 0, 0.15);
}

.gt-footer {
    flex-direction: row;
    align-items: center;
    padding: 5px 10px;
    background-color: rgba(128, 128, 128, 0.08);
    border-top-width: 1px;
    border-top-color: rgba(0, 0, 0, 0.25);
    flex-shrink: 0; /* see .gt-toolbar */
}

.gt-footer Label {
    opacity: 0.75;
    font-size: 11px;
}

.gt-split {
    flex-grow: 1;
}
